<?xml version="1.0"?>
<!--
license:BSD-3-Clause
copyright-holders:MAMEdev Team

RC702 display layout — midpoint PAR (~0.77), 20-pixel border in screen background colour.
i8275 timing: total raster 756×308 → correct 4:3 PAR=0.543 (608×550) vs square (1120×550).
Midpoint width: (1120+608)/2 = 864. Border 20px each side → view 904×590.
Background colour matches rc702_palette pen 0: rgb(0xC0, 0x60, 0x00).
-->
<mamelayout version="2">

	<element name="bg">
		<rect>
			<color red="0.7529" green="0.3765" blue="0.0" />
		</rect>
	</element>

	<view name="Standard">
		<bounds x="0" y="0" width="904" height="590" />
		<element ref="bg">
			<bounds x="0" y="0" width="904" height="590" />
		</element>
		<screen index="0">
			<bounds x="20" y="20" width="864" height="550" />
		</screen>
	</view>

</mamelayout>
