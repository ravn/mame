<?xml version="1.0"?>
<!--
license:BSD-3-Clause
copyright-holders:MAMEdev Team

RC702 display layout — 2x default size, 20-pixel border in screen background colour.
Screen content: 80 cols × 7px = 560px wide, 25 rows × 11 scanlines = 275px tall.
At 2x: screen 1120×550, border 20px each side, view 1160×590.
Background colour matches rc702_palette pen 0: rgb(0xC0, 0x60, 0x00).
-->
<mamelayout version="2">

	<element name="bg">
		<rect>
			<color red="0.7529" green="0.3765" blue="0.0" />
		</rect>
	</element>

	<view name="Standard">
		<bounds x="0" y="0" width="1160" height="590" />
		<element ref="bg">
			<bounds x="0" y="0" width="1160" height="590" />
		</element>
		<screen index="0">
			<bounds x="20" y="20" width="1120" height="550" />
		</screen>
	</view>

</mamelayout>
